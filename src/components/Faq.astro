---
import { getCollection } from 'astro:content';
import type { Locale } from '../i18n';

interface Props {
  t: any;
  lang: Locale;
}
const { t, lang } = Astro.props;
const items = (await getCollection('faq')).sort((a, b) => a.data.order - b.data.order);
---

<section class="container-page py-16 sm:py-20 rule-t">
  <h2 class="text-2xl sm:text-3xl font-bold text-center mb-10">{t.faq.title}</h2>
  <div class="container-prose mx-auto divide-y divide-rule">
    {
      items.map((item) => (
        <details class="group py-4">
          <summary class="flex items-center justify-between gap-4 cursor-pointer list-none font-medium">
            <span>{item.data.question[lang]}</span>
            <span class="text-muted font-nums shrink-0 group-open:rotate-45 transition-transform">+</span>
          </summary>
          <p class="mt-3 text-sm sm:text-base text-muted leading-relaxed">
            {item.data.isTodo ? 'TODO_FAQ' : item.data.answer[lang]}
          </p>
        </details>
      ))
    }
  </div>
</section>

<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: items.map((item) => ({
      '@type': 'Question',
      name: item.data.question[lang],
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.data.isTodo ? 'TODO_FAQ' : item.data.answer[lang],
      },
    })),
  })}
/>
