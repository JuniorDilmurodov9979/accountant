---
import { getCollection } from 'astro:content';
import { site } from '../data/site';
import LeadForm from './LeadForm.astro';
import type { Locale } from '../i18n';

interface Props {
  t: any;
  lang: Locale;
}
const { t, lang } = Astro.props;
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const serviceOptions = services.map((s) => s.data.title[lang]);
---

<section id="kontakt" class="container-page py-16 sm:py-20 rule-t">
  <div class="container-prose mx-auto">
    <h2 class="text-2xl sm:text-3xl font-bold mb-2 text-center">{t.contact.title}</h2>
    <p class="text-center text-muted mb-10">{t.contact.subtitle}</p>

    <div class="grid sm:grid-cols-2 gap-4 mb-10">
      <a href={site.phoneHref} class="rule px-5 py-4 text-center font-nums text-lg hover:border-ink">
        {site.phone}
      </a>
      <a
        href={site.telegramHref}
        class="rule px-5 py-4 text-center font-medium bg-ledger text-paper hover:opacity-90"
      >
        {t.contact.telegram}
      </a>
    </div>

    <LeadForm t={t} serviceOptions={serviceOptions} />
  </div>
</section>
