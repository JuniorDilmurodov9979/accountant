---
import { site } from '../data/site';
interface Props {
  t: any;
}
const { t } = Astro.props;
---

<section class="container-page pt-12 sm:pt-20 pb-16">
  <div class="container-prose mx-auto text-center">
    <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold leading-tight">
      {t.hero.title}
    </h1>
    <p class="mt-6 text-base sm:text-lg text-muted leading-relaxed">
      {t.hero.subtitle}
    </p>
    <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href="#kontakt"
        class="w-full sm:w-auto px-6 py-3 bg-ledger text-paper font-medium text-sm sm:text-base"
      >
        {t.hero.ctaPrimary}
      </a>
      <a
        href={site.telegramHref}
        class="w-full sm:w-auto px-6 py-3 text-ledger font-medium text-sm sm:text-base border border-ledger"
      >
        {t.hero.ctaSecondary} →
      </a>
    </div>
  </div>
</section>
