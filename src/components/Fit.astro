---
interface Props {
  t: any;
}
const { t } = Astro.props;
---

<section class="container-page py-16 sm:py-20">
  <h2 class="text-2xl sm:text-3xl font-bold text-center mb-10">{t.fit.title}</h2>
  <div class="grid sm:grid-cols-2 gap-px bg-rule rule">
    <div class="bg-paper p-6 sm:p-8">
      <h3 class="font-display font-semibold text-ledger mb-4">{t.fit.goodTitle}</h3>
      <ul class="space-y-3 text-sm sm:text-base">
        {
          t.fit.good.map((item: string) => (
            <li class="flex gap-2">
              <span class="text-ledger font-nums">+</span>
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="bg-paper p-6 sm:p-8">
      <h3 class="font-display font-semibold text-muted mb-4">{t.fit.badTitle}</h3>
      <ul class="space-y-3 text-sm sm:text-base text-muted">
        {
          t.fit.bad.map((item: string) => (
            <li class="flex gap-2">
              <span class="font-nums">−</span>
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
