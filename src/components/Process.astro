---
interface Props {
  t: any;
}
const { t } = Astro.props;
---

<section class="container-page py-16 sm:py-20">
  <h2 class="text-2xl sm:text-3xl font-bold text-center mb-10">{t.process.title}</h2>
  <ol class="container-prose mx-auto grid gap-8 sm:gap-10">
    {
      t.process.steps.map((step: { title: string; text: string }, i: number) => (
        <li class="flex gap-5">
          <span class="font-nums text-ledger text-xl font-medium shrink-0 w-8">{`0${i + 1}`}</span>
          <div>
            <h3 class="font-display font-semibold text-lg mb-1">{step.title}</h3>
            <p class="text-sm sm:text-base text-muted leading-relaxed">{step.text}</p>
          </div>
        </li>
      ))
    }
  </ol>
</section>
