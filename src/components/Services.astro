---
import { getCollection } from 'astro:content';
import type { Locale } from '../i18n';

interface Props {
  t: any;
  lang: Locale;
}
const { t, lang } = Astro.props;
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
---

<section class="container-page py-16 sm:py-20" id="xizmatlar">
  <h2 class="text-2xl sm:text-3xl font-bold text-center mb-3">{t.services.title}</h2>
  <p class="text-center text-sm text-muted mb-10">{t.services.priceNote}</p>
  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-px bg-rule rule">
    {
      services.map((service) => (
        <div class="bg-paper p-6 flex flex-col gap-3">
          <h3 class="font-display font-semibold text-lg">{service.data.title[lang]}</h3>
          <p class="text-sm text-muted leading-relaxed flex-1">{service.data.description[lang]}</p>
          <p class="font-nums text-sm text-ledger pt-2 rule-t">{service.data.priceLabel[lang]}</p>
        </div>
      ))
    }
  </div>
</section>
