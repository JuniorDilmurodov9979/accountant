---
interface Props {
  t: any;
}
const { t } = Astro.props;
---

<section class="container-page py-16 sm:py-20 rule-t">
  <div class="container-prose mx-auto">
    <h2 class="text-2xl sm:text-3xl font-bold mb-10 text-center">{t.about.title}</h2>
    <div class="flex flex-col sm:flex-row gap-8 items-start">
      <img
        src="/photo-placeholder.svg"
        alt={t.about.photoAlt}
        width="160"
        height="160"
        class="w-32 h-32 sm:w-40 sm:h-40 object-cover rule shrink-0 mx-auto sm:mx-0"
      />
      <div>
        <h3 class="font-display font-semibold text-xl">{t.about.name}</h3>
        <p class="text-muted text-sm mb-4">{t.about.role}</p>
        <div class="space-y-3 text-sm sm:text-base leading-relaxed">
          {t.about.bio.map((p: string) => <p>{p}</p>)}
        </div>
        <ul class="flex flex-wrap gap-2 mt-5">
          {
            t.about.credentials.map((c: string) => (
              <li class="text-xs font-nums px-2 py-1 rule text-muted">{c}</li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
