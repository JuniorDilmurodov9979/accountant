---
import CalculatorLayout from '../../../layouts/CalculatorLayout.astro';
import SoliqCalculator from '../../../components/calculators/SoliqCalculator.astro';
import { useTranslations } from '../../../i18n';

const lang = 'uz' as const;
const t = useTranslations(lang);
---

<CalculatorLayout t={t} path="/kalkulyator/soliq-rejimi" title={t.calcSoliq.title} intro={t.calcSoliq.intro}>
  <SoliqCalculator t={t} />
</CalculatorLayout>
