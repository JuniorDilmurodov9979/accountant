---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import BalanceLine from '../../components/BalanceLine.astro';
import Problem from '../../components/Problem.astro';
import Services from '../../components/Services.astro';
import Process from '../../components/Process.astro';
import Fit from '../../components/Fit.astro';
import Calculators from '../../components/Calculators.astro';
import About from '../../components/About.astro';
import Faq from '../../components/Faq.astro';
import Contact from '../../components/Contact.astro';
import { useTranslations } from '../../i18n';

const lang = 'uz' as const;
const t = useTranslations(lang);
---

<BaseLayout
  title="Navoiy ishlab chiqarish korxonalari buxgalteriyasi — autsorsing, tannarx, soliq tekshiruvlari"
  description={t.hero.subtitle}
  path="/"
>
  <Hero t={t} />
  <BalanceLine t={t} />
  <Problem t={t} />
  <Services t={t} lang={lang} />
  <Process t={t} />
  <Fit t={t} />
  <Calculators t={t} />
  <About t={t} />
  <Faq t={t} lang={lang} />
  <Contact t={t} lang={lang} />
</BaseLayout>
