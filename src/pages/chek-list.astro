---
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadForm from '../components/LeadForm.astro';
import { useTranslations } from '../i18n';

const lang = 'ru' as const;
const t = useTranslations(lang);

const title = 'Чек-лист: готовность к налоговой проверке — скачать бесплатно';
const description = 'Бесплатный чек-лист для самопроверки перед визитом налогового инспектора.';
---

<BaseLayout title={title} description={description} path="/chek-list">
  <div class="container-page py-12 sm:py-16">
    <div class="container-prose mx-auto">
      <h1 class="text-2xl sm:text-3xl font-bold mb-4">
        Чек-лист: готовность к налоговой проверке
      </h1>
      <p class="text-muted leading-relaxed mb-10">
        Оставьте номер телефона — вышлю PDF-чек-лист в Telegram: что проверяет инспектор в первую
        очередь и как подготовиться заранее.
      </p>
      <div class="rule p-6 sm:p-8">
        <LeadForm t={t} compact={true} />
      </div>
      <p class="text-xs text-muted mt-8">{t.calcCommon.disclaimer}</p>
    </div>
  </div>
</BaseLayout>
