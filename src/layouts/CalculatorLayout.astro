---
import BaseLayout from './BaseLayout.astro';
import LeadForm from '../components/LeadForm.astro';

interface Props {
  t: any;
  path: string;
  title: string;
  intro: string;
}
const { t, path, title, intro } = Astro.props;
---

<BaseLayout title={title} description={intro} path={path}>
  <div class="container-page py-12 sm:py-16">
    <div class="container-prose mx-auto mb-10">
      <h1 class="text-2xl sm:text-3xl font-bold mb-3">{title}</h1>
      <p class="text-muted leading-relaxed">{intro}</p>
    </div>

    <slot />

    <div class="container-prose mx-auto mt-12 pt-10 rule-t">
      <p class="text-sm text-muted mb-4">{t.calcCommon.getPdfHint}</p>
      <LeadForm t={t} compact={true} />
      <p class="text-xs text-muted mt-8">{t.calcCommon.disclaimer}</p>
    </div>
  </div>
</BaseLayout>
